# ── Database ─────────────────────────────────────────────────────────────────
# cPanel MySQL: format is usually cpaneluser_dbuser / cpaneluser_dbname
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root_password
DB_NAME=ab_logistics

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your live domain (no trailing slash). Comma-separate if needed.
FRONTEND_URL=http://localhost:8083,http://localhost:8081,http://localhost:8080

# ── Cookies ───────────────────────────────────────────────────────────────────
# Set to true once HTTPS is active on the domain
COOKIE_SECURE=false

# ── GST ───────────────────────────────────────────────────────────────────────
# Home state of the company — used for IGST vs CGST/SGST split (e.g. Gujarat)
COMPANY_STATE=
